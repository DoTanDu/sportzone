# CẤU HÌNH SERVER PORT
PORT=5000
NODE_ENV=production

# CẤU HÌNH DATABASE TRÊN AAPANEL (MYSQL / MARIADB)
# Điền thông tin database bạn vừa tạo trên aaPanel:
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sportzone
DB_USER=sportzone
DB_PASSWORD=your_password_here

# KHÓA BẢO MẬT JWT AUTH
JWT_SECRET=sportzone_jwt_secret_key_2026_super_secure
JWT_EXPIRES_IN=7d
